[node name="Scroll" type="ScrollContainer" parent="HowToPlayOverlay/HowToPlayPanel/Margin/Content"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Instructions" type="VBoxContainer" parent="HowToPlayOverlay/HowToPlayPanel/Margin/Content/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="Movement" type="Label" parent="HowToPlayOverlay/HowToPlayPanel/Margin/Content/Scroll/Instructions"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "GET AROUND\nClick an object to send your character there. Once they arrive, its action panel opens."
autowrap_mode = 3

[node name="Resources" type="Label" parent="HowToPlayOverlay/HowToPlayPanel/Margin/Content/Scroll/Instructions"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "MANAGE YOUR SHELTER\nKeep Water, Food, Energy and Nature above their daily targets. Check the bars at the top and the House Tasks pin."
autowrap_mode = 3

[node name="Actions" type="Label" parent="HowToPlayOverlay/HowToPlayPanel/Margin/Content/Scroll/Instructions"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "SPEND ACTIONS WISELY\nYou have 5 actions each day. Most activities cost 1 action; some can only be done once per day."
autowrap_mode = 3

[node name="Water" type="Label" parent="HowToPlayOverlay/HowToPlayPanel/Margin/Content/Scroll/Instructions"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "WATER & FARMING\nThe well gives +12 Water and -5 Nature once per day. Unlock the tank to raise daily Water renewal from +2 to +6. Farm with basic or drip irrigation, then choose a harvest method."
autowrap_mode = 3

[node name="Pond" type="Label" parent="HowToPlayOverlay/HowToPlayPanel/Margin/Content/Scroll/Instructions"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "POND & NATURE\nFish once per day for +8 Food and -1 Nature, or clean the pond once per day for +7 Nature and a flower."
autowrap_mode = 3

[node name="Trees" type="Label" parent="HowToPlayOverlay/HowToPlayPanel/Margin/Content/Scroll/Instructions"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "GROW YOUR GARDEN\nPlant one tree each day. It costs Water and gives Nature; after 10 seconds it matures and adds more Nature. Compost and recycling can also help restore Nature."
autowrap_mode = 3

[node name="Crises" type="Label" parent="HowToPlayOverlay/HowToPlayPanel/Margin/Content/Scroll/Instructions"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "RESPOND TO CRISES\nChoose whether to intervene when a crisis appears. Intervention costs an action but may reduce resource losses."
autowrap_mode = 3
